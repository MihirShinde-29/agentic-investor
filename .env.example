# Copy to .env and fill in what you have. All optional: with no keys the
# app runs in mock mode. .env is gitignored, so never commit real keys.


# =============================================================================
# LLM providers
# =============================================================================
# LiteLLM model strings. Examples:
#   gpt-4o-mini | gpt-4.1-mini | gpt-4o
#   anthropic/claude-haiku-4-5 | anthropic/claude-sonnet-4-5
#   gemini/gemini-2.5-flash

LLM_MODEL=gpt-4o-mini
ORCHESTRATOR_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# =============================================================================
# Alpaca paper trading (M7 + M13 multi-arm A/B)
# =============================================================================
# Sign up free at alpaca.markets. Keep ALPACA_PAPER=true unless you intend
# to trade real money. Multi-arm experiments consume _B and _C accounts;
# each arm needs its own paper account for isolated books.

ALPACA_API_KEY=
ALPACA_API_SECRET=

ALPACA_API_KEY_B=
ALPACA_API_SECRET_B=

ALPACA_API_KEY_C=
ALPACA_API_SECRET_C=

ALPACA_PAPER=true


# =============================================================================
# Data sources
# =============================================================================
# Local embeddings, no key needed. HuggingFace token unlocks gated finBERT
# models. Finnhub adds a second news source alongside Alpaca. SEC EDGAR
# requires a real contact per their fair-access policy.

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
FINNHUB_API_KEY=
SEC_EDGAR_USER_AGENT=agentic-investor (educational; you@example.com)


# =============================================================================
# Observability (Langfuse)
# =============================================================================
# Optional; when both keys are set LiteLLM traces every LLM call into
# Langfuse. Leave blank to disable.

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000


# =============================================================================
# Storage
# =============================================================================

DATABASE_URL=sqlite:///./agentic_investor.db
CHROMA_DIR=./.chroma
DATA_DIR=./data


# =============================================================================
# Dashboard auth
# =============================================================================
# HTTP Basic on the dashboard. Both must be set for auth to kick in; leave
# empty for local dev. Required whenever the dashboard is exposed on a
# public URL (Fly, Railway, etc).

DASHBOARD_USER=
DASHBOARD_PASS=
