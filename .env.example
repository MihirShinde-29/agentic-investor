# Copy to .env and fill in what you have. All optional: with no keys the app
# runs in mock mode. .env is gitignored, so never commit real keys.

# LLM (LiteLLM model strings).
# Examples: gpt-4o-mini | gemini/gemini-2.5-flash | anthropic/claude-haiku-4-5
LLM_MODEL=gpt-4o-mini
ORCHESTRATOR_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# API keys (fill only the provider you use).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FINNHUB_API_KEY=

# Local embeddings, no key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# SEC EDGAR: use a real contact per their fair-access policy.
SEC_EDGAR_USER_AGENT=agentic-investor (educational; you@example.com)

# Observability (Langfuse), added in M6.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Storage.
DATABASE_URL=sqlite:///./agentic_investor.db
CHROMA_DIR=./.chroma
DATA_DIR=./data

# Alpaca paper trading (M7). Sign up free at alpaca.markets.
# Keep ALPACA_PAPER=true unless you intend to trade real money.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
