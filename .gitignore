# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets, never commit real keys
.env

# Local data / vector store / databases / plot output
data/
.chroma/
out/*
*.db
*.sqlite3
*.png

# Track the eval baseline so CI's regression gate has something to compare to.
!out/eval/
out/eval/*
!out/eval/baseline_scorecard.json

# Caches
.pytest_cache/
.ruff_cache/

# Local flyctl/session log dumps (created for offline analysis).
session_*.log
logs_*.txt

# Frontend build artifacts + deps
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
